      },
      "comoOLeadEAchado": [
        "com lead_ref: pelo ponto e pela chave de idempotencia",
        "sem lead_ref, ou sem achado: o lead mais recente do mesmo ponto com o mesmo e-mail (sem e-mail, o mesmo telefone) criado nos ultimos 10 minutos"
      ],
      "respostaDeSucesso": { "status": 200, "corpo": { "ok": true }, "nota": "o relato nunca vira instrucao: o Track so registra e compara com o ponto" },
      "respostasPorEstado": [
        { "quando": "cabecalho X-Amber-Track-Api ausente ou diferente de 1", "status": 400, "erro": "VERSAO_API" },
        { "quando": "segredo ausente, fora do formato ou desconhecido", "status": 401, "erro": "SEGREDO_INVALIDO" },
