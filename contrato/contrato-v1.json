            "nome": "lead completo",
            "corpo": {
              "ponto": "pc_0123456789ABCDEF",
              "idempotencia": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
              "contato": { "nome": "Maria Silva", "email": "maria@example.com", "telefone": "+55 (11) 98765-4321" },
