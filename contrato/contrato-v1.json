{
  "contrato": "amber-track-api",
  "versao": 1,
  "descricao": "Contrato da API v1 do Amber Track (captura). Este arquivo mora, byte a byte, na Dash (lib/track/api-v1/contrato-v1.json) e no repositorio do pacote. Mudou num, muda no outro no mesmo par de PRs. Spec: .specs/#95-amber-track-captura-e-atribuicao/01-ponto-de-captura-e-api.md, secoes 6 e 7. Todos os exemplos sao ficticios.",
  "prefixo": "/api/track/v1/",
  "host": "so o host da Dash; nenhum dominio de links atende este prefixo",
  "cabecalhos": {
    "api": { "nome": "X-Amber-Track-Api", "valor": "1", "obrigatorio": true, "seInvalido": { "status": 400, "erro": "VERSAO_API" } },
    "pacote": { "nome": "X-Amber-Track-Pacote", "formato": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "obrigatorio": true }
  },
  "corpoDeErro": { "erro": "<CODIGO>", "mensagem": "<texto para quem le o log>" },
  "formatos": {
    "ponto": "^pc_[0-9A-HJKMNP-TV-Z]{16}$",
    "segredo": "^ats_[0-9A-HJKMNP-TV-Z]{32}$",
    "idempotencia": "^[0-9a-f]{64}$",
    "atk": "^clk_[0-9A-HJKMNP-TV-Z]{16}$",
    "abv": "^abv_[a-z0-9]{16}$",
    "chaveDeCampo": "^[a-z][a-z0-9_]{0,39}$",
    "tagPorId": "^#[0-9]+$"
  },
  "limites": {
    "corpoDoLeadBytes": 16384,
    "corpoDoRelatoBytes": 4096,
    "corpoDoEventoBytes": 4096,
    "nomeMax": 120,
    "emailMax": 254,
    "telefoneMinDigitos": 10,
    "telefoneMaxDigitos": 15,
    "camposMaxChaves": 30,
    "campoValorMax": 500,
    "utmMax": 255,
    "fbMax": 500,
    "paginaMax": 200,
    "referrerHostMax": 255,
    "relatoTagsMax": 20,
    "relatoTagNomeMax": 255,
    "relatoDetalheMax": 200,
    "eventosPorIpPorMinuto": 60,
    "leadsPorSitePorMinuto": 600
  },
  "vocabulario": {
    "tiposDeEvento": ["visita"],
    "resultadosDoRelato": ["ok", "pendente", "erro"],
    "entregas": ["pagina", "track"],
    "chavesProibidasEmCampos": ["tag", "tags", "lista", "list"],
    "chavesReservadasEmCampos": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid", "fbp", "pagina"]
  },
  "erros": {
    "VERSAO_API": 400,
    "SEGREDO_INVALIDO": 401,
    "SITE_PAUSADO": 403,
    "PONTO_DE_OUTRO_SITE": 403,
    "ORIGEM_NAO_PERMITIDA": 403,
    "PONTO_INEXISTENTE": 404,
    "LEAD_INEXISTENTE": 404,
    "CORPO_GRANDE": 413,
    "SEM_CONTATO": 422,
    "CAMPO_PROIBIDO": 422,
    "CAMPO_DESCONHECIDO": 422,
    "CORPO_INVALIDO": 422,
    "TIPO_DE_EVENTO_DESCONHECIDO": 422,
    "LIMITE_SITE": 429,
    "LIMITE_IP": 429,
    "CAPTURA_DESLIGADA": 503,
    "BANCO_INDISPONIVEL": 503
  },
  "regraDoPacote": "Qualquer resposta diferente de 200 em /leads significa: a pagina entrega pelo caminho dela.",
  "rotas": {
    "leads": {
      "metodo": "POST",
      "caminho": "/api/track/v1/leads",
      "quemChama": "servidor da pagina",
      "autenticacao": "Authorization: Bearer <segredo do site>",
      "contentType": "application/json",
      "corpoMaxBytes": 16384,
      "estrito": "em todo nivel: chave que nao esta no esquema (no corpo, em contato, em marcas ou em entrega_pagina) devolve 422 CAMPO_DESCONHECIDO",
      "corpo": {
        "ponto": { "obrigatorio": true, "formato": "ponto" },
        "idempotencia": { "obrigatorio": true, "formato": "idempotencia", "nota": "sha256 calculado pelo pacote uma vez por envio; o pacote a devolve a pagina como leadRef" },
        "contato": {
          "obrigatorio": true,
          "campos": {
            "nome": { "obrigatorio": false, "max": 120, "nota": "sem espaco nas pontas" },
            "email": { "obrigatorio": false, "max": 254, "nota": "e-mail valido" },
            "telefone": { "obrigatorio": false, "nota": "10 a 15 digitos depois de tirar tudo que nao e digito" }
          },
          "regra": "e-mail ou telefone obrigatorio; sem os dois, 422 SEM_CONTATO"
        },
        "campos": { "obrigatorio": false, "nota": "ate 30 chaves no formato chaveDeCampo, cada valor texto ate 500; chave proibida ou reservada devolve 422 CAMPO_PROIBIDO" },
        "marcas": {
          "obrigatorio": false,
          "campos": {
            "atk": { "obrigatorio": false, "formato": "atk", "nota": "fora do formato e descartado, sem erro" },
            "abv": { "obrigatorio": false, "formato": "abv" },
            "utm_source": { "obrigatorio": false, "max": 255 },
            "utm_medium": { "obrigatorio": false, "max": 255 },
            "utm_campaign": { "obrigatorio": false, "max": 255 },
            "utm_content": { "obrigatorio": false, "max": 255 },
            "utm_term": { "obrigatorio": false, "max": 255 },
            "fbclid": { "obrigatorio": false, "max": 500 },
            "fbp": { "obrigatorio": false, "max": 500 },
            "pagina": { "obrigatorio": false, "max": 200, "nota": "caminho sem query" },
            "referrer_host": { "obrigatorio": false, "max": 255, "nota": "so o host" }
          }
        },
        "reenvio": { "obrigatorio": false, "tipo": "booleano", "nota": "true no reenvio tardio do pacote" },
        "entrega_pagina": {
          "obrigatorio": false,
          "nota": "o relato da pagina que pega carona no reenvio tardio; dado informado, nunca instrucao",
          "campos": {
            "resultado": { "obrigatorio": true, "valores": ["ok", "pendente", "erro"] },
            "tags": { "obrigatorio": false, "nota": "ate 20; cada uma o nome (ate 255) ou #<id numerico>" },
            "lista": { "obrigatorio": false, "tipo": "inteiro ou nulo" },
            "detalhe": { "obrigatorio": false, "max": 200, "nota": "o servidor mascara e-mail e telefone antes de gravar" }
          }
        }
      },
      "respostaDeSucesso": {
        "status": 200,
        "corpo": { "lead": "<uuid>", "novo": "true|false", "entrega": "pagina|track" },
        "nota": "com novo=false, entrega sai do modo gravado no lead, nunca do ponto de agora"
      },
      "respostasPorEstado": [
        { "quando": "cabecalho X-Amber-Track-Api ausente ou diferente de 1", "status": 400, "erro": "VERSAO_API" },
        { "quando": "segredo ausente, fora do formato ou desconhecido", "status": 401, "erro": "SEGREDO_INVALIDO" },
        { "quando": "site do segredo pausado", "status": 403, "erro": "SITE_PAUSADO" },
        { "quando": "ponto de outro site", "status": 403, "erro": "PONTO_DE_OUTRO_SITE" },
        { "quando": "ponto que nao existe", "status": 404, "erro": "PONTO_INEXISTENTE" },
        { "quando": "corpo acima de 16 KB", "status": 413, "erro": "CORPO_GRANDE" },
        { "quando": "mais de 600 leads do site no minuto", "status": 429, "erro": "LIMITE_SITE" },
        { "quando": "TRACK_CAPTURE_ENABLED=false", "status": 503, "erro": "CAPTURA_DESLIGADA" },
        { "quando": "banco fora", "status": 503, "erro": "BANCO_INDISPONIVEL" }
      ],
      "exemplos": {
