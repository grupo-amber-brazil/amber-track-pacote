{
  "name": "@amber/track",
  "version": "0.1.0",
  "description": "Liga as páginas da Amber ao Amber Track: cookie do clique no proxy, lead e relato no servidor, visita e sck no navegador. Sem dependência de runtime.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\""
  },
  "peerDependencies": {
    "next": ">=15.1 <17",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
