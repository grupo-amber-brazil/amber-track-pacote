# Copie para .env.local e troque pelos valores da SUA Dash local. Nada de produção aqui.

# Dash local (a branch da Dash rodando na sua máquina).
# O servidor do exemplo fala com a Dash pelo relé do E2E (e2e/rele.mjs, porta 3999), que o
# roteiro 4 desliga para simular a Dash fora. Sem o relé, use http://localhost:3000 direto.
AMBER_TRACK_URL=http://localhost:3999
E2E_DASH_DIRETA=http://localhost:3000
# A visita sai do navegador direto para a Dash.
NEXT_PUBLIC_AMBER_TRACK_URL=http://localhost:3000
# Segredo do site criado na Dash local (mostrado uma vez, ao criar o site). Fictício abaixo.
AMBER_TRACK_SITE_SECRET=ats_00000000000000000000000000000000
# Chave pública de um ponto desse site. Fictícia abaixo.
AMBER_TRACK_PONTO=pc_0000000000000000

# O que o "caminho da página" simulado aplica no AC simulado (o mesmo que o ponto tem na Dash local).
EXEMPLO_TAGS=[Exemplo] Lead
EXEMPLO_LISTA=1
# Host fictício: o interceptador do E2E responde por ele. Nunca aponte para uma conta de verdade.
AC_BASE_URL=https://exemplo-e2e.api-us1.com

# Só para os roteiros do E2E (e2e/LEIA.md).
# Postgres da Dash LOCAL (descartável). O script recusa qualquer host que não seja localhost.
# Banco local de teste, em porta própria (não use 5432 nem 5433, que podem ser túnel de outro banco).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/dash_e2e
EXEMPLO_URL=http://localhost:3100
# Código do clique criado na Dash local para o roteiro 1 (clk_ + 16).
E2E_CLIQUE=clk_0000000000000000
# Log e controle do AC simulado, compartilhados entre o exemplo e o worker da Dash local.
AC_SIMULADO_LOG=./e2e/saida/ac-simulado.jsonl
AC_SIMULADO_CONTROLE=./e2e/saida/ac-simulado-controle.json
